<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mnestix.AasGenerator.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mnestix</Authors>
    <Description>Pure, in-memory AAS Generator engine: maps blueprint and data documents into AAS v3.0-conformant shell and submodel objects. No HTTP, repository access, or persistence.</Description>
    <RepositoryUrl>https://github.com/eclipse-mnestix/mnestix-aas-generator</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Tests" />
    <InternalsVisibleTo Include="Integration.Tests" />
    <InternalsVisibleTo Include="Web.Tests" />
    <InternalsVisibleTo Include="MnestixApi" />
    <InternalsVisibleTo Include="Mnestix.AasGenerator.Integration" />
    <InternalsVisibleTo Include="Mnestix.AasGenerator.DefaultTemplates" />
    <!-- Allows Moq/Castle DynamicProxy to mock internal types from the test assemblies. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jsonata.Net.Native" Version="2.11.0" />
    <PackageReference Include="Jsonata.Net.Native.JsonNet" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="AasCreator\Templates\aas.json" />
    <EmbeddedResource Include="AasCreator\Templates\aas.json" />
  </ItemGroup>

</Project>
