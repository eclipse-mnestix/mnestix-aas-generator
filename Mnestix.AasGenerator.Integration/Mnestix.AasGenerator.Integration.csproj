<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mnestix.AasGenerator.Integration</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mnestix</Authors>
    <Description>Repository integration for the Mnestix AAS Generator: BaSyx repository client, blueprint and id-generation-settings fetching, id assembly, and orchestration that drives the pure Mnestix.AasGenerator.Core engine to create and persist AAS shells and submodels.</Description>
    <RepositoryUrl>https://github.com/eclipse-mnestix/mnestix-aas-generator</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integration.Tests" />
    <InternalsVisibleTo Include="Core.Tests" />
    <InternalsVisibleTo Include="Web.Tests" />
    <InternalsVisibleTo Include="MnestixApi" />
    <InternalsVisibleTo Include="Mnestix.AasGenerator.DefaultTemplates" />
    <!-- Allows Moq/Castle DynamicProxy to mock internal types from the test assemblies. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IdentityModel" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MnestixCore\MnestixCore.csproj" />
  </ItemGroup>

</Project>
